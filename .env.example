# ---- Server ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---- Database ----
# Standalone Mongo works, but a replica set (or Atlas) enables atomic batch push.
# Local replica set example: mongodb://127.0.0.1:27017/listaplus?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/listaplus

# ---- Auth ----
# Long random string. Rotating this invalidates every issued API token.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# OAuth *Web* client ID from Google Cloud Console — must match the audience of the
# ID token the Android app sends (the app's requestIdToken(...) server client ID).
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# ---- Google Play Billing ----
APP_PACKAGE=com.jorres.listaplus
# Either an absolute path to the service-account JSON key file, or the raw JSON itself.
# The service account needs "View financial data" on the Play Console app.
GOOGLE_PLAY_SA_KEY=./secrets/play-service-account.json

# ---- Abuse guards ----
# Max synced documents per account, summed across entity types. 0 disables.
SYNC_MAX_DOCS_PER_USER=200000

# ---- CORS ----
# Comma-separated allowlist. Leave empty to disallow all browser origins.
# The Android app is not a browser and is unaffected by CORS.
CORS_ORIGINS=
